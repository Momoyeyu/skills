models:
  - id: google/gemini-3-pro-image-preview
    label: banana-pro
    # api_base and api_key default to OpenRouter if omitted
  - id: gpt-image-1
    label: openai
    api_base: https://api.openai.com/v1
    api_key: ${OPENAI_API_KEY}   # ${xxx} reads env var; literal strings also work

images:
  - name: example
    output_dir: public/img/posts/my-post
    prompt: |
      Generate a diagram. Landscape 16:9, high resolution.
